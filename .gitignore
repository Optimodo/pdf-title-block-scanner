.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Reports and debug dumps
reports/
debug/
*.xlsx
!tests/fixtures/**

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
